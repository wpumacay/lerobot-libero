<mujoco model="franka_droid">
  <compiler angle="radian" />

  <option integrator="implicitfast"/>

  <default>
    <!-- Have do duplicate these daults as childclass is not supported by the current robosuite version -->
    <joint armature="0.1" damping="1"/>
    <position inheritrange="1"/>
    <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="1"/>

    <default class="fr3">
      <joint armature="0.1" damping="1"/>
      <position inheritrange="1"/>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="1"/>
    </default>
    <default class="visual">
      <geom type="mesh" group="1" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom type="mesh" group="0" mass="0" density="0"/>
    </default>


    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
    </default>
  </default>

  <asset>
